#!/usr/bin/env python3
"""esp-monitor - serial console for the ESP32 over the CP2102.

There is no /dev/ttyUSB* node in this environment (kernel built without
CONFIG_USB_SERIAL_CP210X), so screen/minicom cannot open the board. This is a
self-contained replacement: it talks to the CP2102 through the userspace
driver and bridges it to your terminal.

Examples:
    esp-monitor                 # watch output at 115200
    esp-monitor --reset         # reset the chip first, to catch the boot log
    esp-monitor -b 748800       # other baud rate
    echo -n "help" | esp-monitor
"""

import argparse
import os
import select
import sys
import termios
import time
import tty

sys.path.insert(0, "/opt/esp-bridge")

from cp210x_usb import CP210xSerial, CP210xError  # noqa: E402


def hard_reset(port):
    """Pulse EN only, keeping IO0 high, so the chip reboots into the flash app.

    This is esptool's HardReset strategy: DTR stays deasserted (IO0 high) and
    only RTS is pulsed (EN low for 100 ms). The app then prints its own boot
    log, which is what a console session wants to see.

    The old implementation here was esptool's ClassicReset - the *download
    mode* sequence - which leaves the chip parked at "waiting for download"
    and silently dead consoles.
    """
    port.setDTR(False)   # IO0 high: boot from flash
    port.setRTS(True)    # EN low
    time.sleep(0.1)
    port.setRTS(False)   # EN high: release into the app
    time.sleep(0.05)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="esp-monitor",
        description="Serial console for the ESP32 via the CP2102 USB bridge.",
    )
    parser.add_argument(
        "-b", "--baud", type=int, default=115200, help="baud rate (default 115200)"
    )
    parser.add_argument(
        "--reset",
        action="store_true",
        help="hard-reset the chip on start so the boot log is captured",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="keep stdin in cooked mode (default: raw, so keys pass through)",
    )
    args = parser.parse_args(argv)

    try:
        port = CP210xSerial(baudrate=args.baud, timeout=0.2)
    except CP210xError as exc:
        print("esp-monitor: %s" % exc, file=sys.stderr)
        return 1

    if args.reset:
        hard_reset(port)
        time.sleep(0.3)

    saved_attrs = None
    if sys.stdin.isatty() and not args.raw:
        saved_attrs = termios.tcgetattr(0)
        tty.setcbreak(0)

    stdin_open = True
    print(
        "[esp-monitor] CP2102 @ %d baud - Ctrl+C to exit" % args.baud,
        file=sys.stderr,
    )

    try:
        while True:
            # terminal -> chip (once stdin hits EOF we simply stop feeding it)
            if stdin_open and select.select([sys.stdin], [], [], 0)[0]:
                data = os.read(0, 1024)
                if not data:
                    stdin_open = False
                else:
                    port.write(data)

            # chip -> terminal
            waiting = port.in_waiting
            if waiting:
                chunk = port.read(waiting)
                if chunk:
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
            else:
                time.sleep(0.01)
    except KeyboardInterrupt:
        print("\n[esp-monitor] stopped", file=sys.stderr)
    finally:
        if saved_attrs is not None:
            termios.tcsetattr(0, termios.TCSADRAIN, saved_attrs)
        port.close()

    return 0


if __name__ == "__main__":
    sys.exit(main())
